# PulseIQ environment template
# Copy this file to .env for local overrides.
# Never commit real API keys. .env is gitignored.

# Historical Cricsheet sample used by the Phase 3 API.
# These files are not live matches.
PULSEIQ_CRICSHEET_DIR=data/raw/cricsheet/samples
PULSEIQ_PROCESSED_DIR=data/processed

# Optional Phase 2 model artifact. If unset, the API loads the newest
# *.joblib file in PULSEIQ_MODEL_DIR. If none exist, win-probability and
# moment endpoints return available=false rather than inventing numbers.
PULSEIQ_MODEL_DIR=backend/models/artifacts
# PULSEIQ_MODEL_PATH=

# Comma-separated browser origins. Empty means no CORS origins.
PULSEIQ_CORS_ORIGINS=http://localhost:3000
PULSEIQ_ENVIRONMENT=development
PULSEIQ_LOG_LEVEL=INFO
PULSEIQ_MAX_REQUEST_BYTES=32768

# LLM explanations. Use exactly one provider.
# mock = in-process, no network (default, used by tests)
# gemini = Google Gemini REST (requires GEMINI_API_KEY)
# openai = OpenAI-compatible chat completions (requires OPENAI_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=mock-explanations-v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reserved for later phases. Do not put secrets in source control.
# DATABASE_URL=
# REDIS_URL=
